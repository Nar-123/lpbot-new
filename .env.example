# =============================================================================
# Copy to .env and fill in. Never commit .env
#   cp .env.example .env
# =============================================================================

# --- Telegram (required) ---
# From @BotFather
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user id(s), comma-separated
# Get id from @userinfobot or similar
TELEGRAM_USER_IDS=

# --- Hot wallet(s) (optional) ---
# Multi-wallet store: data/wallets.json (generate / import via /wallet in Telegram)
# If unset, migrates PRIVATE_KEY or legacy data/hot-wallet.json, else auto-generates
# PRIVATE_KEY=0x...

# Optional path for multi-wallet store (default ./data/wallets.json)
# WALLETS_PATH=./data/wallets.json

# Legacy single-wallet path (migrated once into wallets.json)
# WALLET_PATH=./data/hot-wallet.json

# --- RPC (required for chain ops) ---
# Robinhood Chain (4663) — public RPC often rate-limited; Alchemy/QuickNode recommended
# Example Alchemy: https://robinhood-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_4663=https://rpc.mainnet.chain.robinhood.com

# BNB Smart Chain (56)
RPC_56=https://1rpc.io/bnb

# Base (8453) — public mainnet.base.org is fine for light use; Alchemy/QuickNode for production
RPC_8453=https://mainnet.base.org

# Optional: USDC on Robinhood if you use it
# USDC_4663=0x...

# Optional ledger path (default ./data/bot.json)
# DB_PATH=./data/bot.json

# Optional Relay API key (higher rate limits for /bridge)
# https://docs.relay.link/references/api/api-keys
# RELAY_API_KEY=

# Across Swap API — raced with Relay for best bridge/swap quote
# https://docs.across.to/tools/integrator-id
# ACROSS_API_KEY=acx_...
# ACROSS_INTEGRATOR_ID=0x...

# Uniswap Trading API — multi-hop v2/v3/v4 for /swap custom CA (mint helpers)
# https://developers.uniswap.org/
# NOT used for close zapout or /tokens meme sell (those hard-require GMGN)
# UNISWAP_API_KEY=

# --- GMGN (required for zapout + /screener + /tokens sell) ---
# Install: https://github.com / gmgn-cli binary on PATH
# Credentials live in ~/.config/gmgn/ (gmgn-cli config) — this process never reads the key
# GMGN_CLI_PATH=gmgn-cli
# GMGN_SLIPPAGE_PCT=15
# GMGN_SWAP_MODE=local
#   local (default): gmgn-cli order quote → bot hot wallet signs
#   managed: gmgn-cli swap signs from the wallet bound to your GMGN API key
#            (imports hot key into GMGN — see SECURITY.md)
# GMGN_WALLET_ADDRESS=0x...          # only if managed
# GMGN_ALLOW_AUTOMATED_TRADES=1      # only if managed

# --- Autonomous LLM agent (optional, opt-in, default OFF) ---
# Off by default — leaving AGENT_MODE unset changes nothing about existing
# behavior. When on, /agent becomes available in Telegram; the agent's
# tools (deploy_position, close_position) still go through the exact same
# deterministic filters, risk gate, and locks as manual commands / MULTI —
# it never gets a private execution path. See src/agent/ for details.
# AGENT_MODE=on
# ANTHROPIC_API_KEY=sk-ant-...
# AGENT_MODEL=claude-sonnet-4-6
# AGENT_MAX_STEPS=20            # LLM round-trips per /agent invocation
# AGENT_MAX_ACTIONS_PER_RUN=3   # deploy_position/close_position calls per invocation (independent of AGENT_MAX_STEPS)
#
# LLM provider — default 'anthropic' (ANTHROPIC_API_KEY above), unset means
# no change to existing behavior. Set to 'openrouter' to route the agent
# through OpenRouter's OpenAI-compatible API instead.
# AGENT_LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-...
# AGENT_MODEL=openai/gpt-4o-mini
#
# Autonomous scheduling — a SEPARATE, higher-friction opt-in from AGENT_MODE
# above. AGENT_MODE=on alone only makes the manual /agent command available;
# nothing runs on its own until this is ALSO explicitly turned on.
# AGENT_AUTONOMOUS_SCHEDULE=on
# AGENT_SCREENING_INTERVAL_MIN=30   # how often the screener role looks for new entries
# AGENT_MANAGEMENT_INTERVAL_MIN=10  # how often the manager role reviews open positions

# --- MULTI: range width preset (optional; default preset=normal, 50%) ---
# MULTI_RANGE_PERCENT (if set) always wins over MULTI_RANGE_PRESET — set
# either one, not both.
# MULTI_RANGE_PRESET=normal        # tight (15%) | normal (50%, default) | wide (80%)
# MULTI_RANGE_PERCENT=50           # raw override, takes priority over the preset above
# MULTI_MIN_RANGE_PERCENT=10       # resolved width below this disables MULTI (fail-closed)
# MULTI_MAX_RANGE_PERCENT=90       # resolved width above this disables MULTI (fail-closed)

# --- MULTI: minimum KOL count filter (optional; default off) ---
# MULTI_MIN_KOL_COUNT=0   # 0 = disabled (default). Naikkan untuk
#   mensyaratkan minimal N KOL/renowned wallet memegang token
#   (dari data GMGN renowned_count) sebelum MULTI mau masuk.

# --- MULTI: self-tuning pool-scoring weights (optional; default off) ---
# Off by default — leaving this unset changes nothing about existing
# behavior; MULTI keeps using the static MULTI_POOL_*_WEIGHT values above.
# When on, the pool-scoring weights (TVL / volume / volume-TVL ratio / fee)
# are periodically replaced with a tuned set recalculated from real
# closed-position history of positions MULTI itself opened (recalculated
# after every MULTI position close — see strategy/signalWeights.ts). This
# is pure statistics (win/loss lift per signal) — it does NOT involve the
# LLM agent in any way. It also needs at least 5 winning AND 5 losing
# closed MULTI positions within the last 30 days before it changes any
# weight at all (src/strategy/signalWeights.ts's minSamplesPerClass=5,
# windowDays=30 defaults) — with fewer closed positions than that, the
# static weights above are used completely unchanged.
# MULTI_SELF_TUNE_WEIGHTS=on

# --- Multi-rule exit engine (optional; stop-loss/take-profit come from /tp) ---
# Safety exit and the out-of-range/pumped-above-range rules are ON by
# default once /tp is enabled on a position — everything below is tunable,
# none of it is required.
# EXIT_MIN_POSITION_DURATION_MIN=5       # suppress every soft exit rule below this age (stop-loss is exempt)
# EXIT_SAFETY_ENABLED=true               # breakeven-lock after a deep drawdown
# EXIT_SAFETY_TRIGGER_PCT=-8
# EXIT_SAFETY_TP_PCT=0
# EXIT_PUMPED_ABOVE_RANGE_TICKS=5000
# EXIT_OOR_WAIT_MINUTES=30
# EXIT_OOR_MAX_HOLD_MULTIPLIER=4         # force-close near-breakeven OOR positions after this many wait-periods
# EXIT_OOR_CLOSE_LOSS_PCT=-3
# EXIT_MIN_PROFIT_PCT=2                  # OOR + at least this much profit banks immediately
# EXIT_LOW_YIELD_ENABLED=false           # opt-in — fees-earned/position-value floor
# EXIT_LOW_YIELD_MIN_AGE_MIN=60
# EXIT_LOW_YIELD_MIN_FEE_VALUE_RATIO=0.0005
# EXIT_TRAILING_ENABLED=false            # opt-in — arms after peak PnL crosses the trigger, exits on drop-from-peak
# EXIT_TRAILING_TRIGGER_PCT=15
# EXIT_TRAILING_DROP_PCT=5
